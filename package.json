{
  "name": "blood-donation-management-system",
  "version": "1.0.0",
  "description": "Life Link — Direct Verified Blood Exchange (Express REST API + Prisma + MySQL)",
  "main": "server.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./src/output.css",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "start": "node server.js",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "test": "node tests/smoke.js",
    "test:api": "node --test tests/api.test.js",
    "test:all": "node tests/smoke.js && node --test --test-concurrency=1 tests/a1.test.js tests/a2.test.js tests/a3.test.js tests/b1.test.js tests/b2.test.js tests/b3.test.js tests/c1.test.js tests/c2.test.js tests/c3.test.js tests/demo.test.js tests/security.test.js tests/policies.test.js tests/deployment-verification.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "blood-donation",
    "healthcare",
    "lifelink",
    "express",
    "prisma",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19"
  }
}
