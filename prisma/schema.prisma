generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UrgencyLevel {
  STANDARD
  URGENT
  EMERGENCY
}

enum RequestStatus {
  OPEN
  CLOSED
}

enum ClosureReason {
  FULFILLED
  CANCELLED
  EXPIRED
}

enum DonorResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum RequesterDecisionStatus {
  NONE
  APPROVED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  RESTRICTED
}

enum ReportCategory {
  FALSE_DONOR_INFO
  HARASSMENT
  INAPPROPRIATE_CONTENT
  SUSPICIOUS_ACTIVITY
}

model User {
  id                   Int                 @id @default(autoincrement())
  name                 String              @db.VarChar(120)
  username             String              @unique @db.VarChar(80)
  email                String              @unique @db.VarChar(160)
  passwordHash         String              @db.VarChar(255)
  phone                String              @db.VarChar(30)
  isDonor              Boolean             @default(false)
  bloodGroup           String              @db.VarChar(5)
  city                 String              @default("Lahore") @db.VarChar(80)
  area                 String              @default("Model Town & Surrounds") @db.VarChar(160)
  shortArea            String              @default("Model Town") @db.VarChar(80)
  donorIdCode          String?             @unique @db.VarChar(24)
  available            Boolean             @default(false)
  online               Boolean             @default(true)
  seenLabel            String              @default("Available Now") @db.VarChar(60)
  replyLabel           String              @default("< 15 mins") @db.VarChar(40)
  lastConfirmedAt      DateTime            @default(now())
  lastAvailabilityUpdate DateTime?
  deactivatedAt        DateTime?
  strictPhoneShielding Boolean             @default(true)
  matchingRadiusKm     Int                 @default(10)
  safetyFlags          Int                 @default(0)
  restrictedUntil      DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  createdRequests      BloodRequest[]      @relation("RequesterRequests")
  responses            RequestResponse[]   @relation("DonorResponses")
  sentInvitations      ChatInvitation[]      @relation("SentInvitations")
  receivedInvitations  ChatInvitation[]      @relation("ReceivedInvitations")
  conversationsAsA     Conversation[]        @relation("ConversationsAsA")
  conversationsAsB     Conversation[]        @relation("ConversationsAsB")
  restrictedConvs      Conversation[]        @relation("ConversationRestrictions")
  sentConvMessages     ConversationMessage[] @relation("SentMessages")
  notifications        Notification[]
  reportsFiled         SafetyReport[]      @relation("ReporterReports")
  reportsReceived      SafetyReport[]      @relation("TargetReports")
  restrictions         RestrictionRecord[] @relation("UserRestrictions")

  @@index([bloodGroup, available])
  @@index([city])
  @@map("users")
}

model BloodRequest {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(24)
  requesterId   Int
  bloodGroup    String         @db.VarChar(5)
  hospital      String         @db.VarChar(160)
  city          String         @default("Lahore") @db.VarChar(80)
  area          String         @db.VarChar(160)
  radius        Int            @default(10)
  requiredDate  DateTime
  units         Int            @default(1)
  urgency       UrgencyLevel   @default(URGENT)
  contactPhone  String         @db.VarChar(30)
  message       String?        @db.Text
  status        RequestStatus  @default(OPEN)
  closureReason ClosureReason?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  requester User              @relation("RequesterRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  responses RequestResponse[]

  @@index([status, bloodGroup])
  @@index([requesterId])
  @@map("blood_requests")
}

model RequestResponse {
  id                Int                     @id @default(autoincrement())
  requestId         Int
  donorId           Int
  donorResponse     DonorResponseStatus     @default(PENDING)
  requesterDecision RequesterDecisionStatus @default(NONE)
  distanceKm        Float?
  respondedAt       DateTime?
  decidedAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor   User         @relation("DonorResponses", fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([requestId, donorId])
  @@index([donorId, donorResponse])
  @@map("request_responses")
}

model ChatInvitation {
  id          Int              @id @default(autoincrement())
  senderId    Int
  recipientId Int
  status      InvitationStatus @default(PENDING)
  rejectedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sender    User @relation("SentInvitations",     fields: [senderId],    references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedInvitations", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, recipientId])
  @@index([recipientId, status])
  @@map("chat_invitations")
}

model Conversation {
  id               Int      @id @default(autoincrement())
  userAId          Int
  userBId          Int
  restrictedById   Int?
  requiresReinvite Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userA      User                  @relation("ConversationsAsA",      fields: [userAId],        references: [id], onDelete: Cascade)
  userB      User                  @relation("ConversationsAsB",      fields: [userBId],        references: [id], onDelete: Cascade)
  restrictor User?                 @relation("ConversationRestrictions", fields: [restrictedById], references: [id], onDelete: SetNull)
  messages   ConversationMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("conversations")
}

model ConversationMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  text           String   @db.VarChar(1000)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String   @default("REQUEST_MATCH") @db.VarChar(40)
  reference   String   @default("") @db.VarChar(120)
  title       String   @db.VarChar(160)
  description String   @db.VarChar(255)
  route       String   @default("/requests") @db.VarChar(80)
  unread      Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, reference])
  @@index([userId, unread])
  @@map("notifications")
}

model SafetyReport {
  id           Int            @id @default(autoincrement())
  targetUserId Int
  reporterId   Int
  category     ReportCategory @default(SUSPICIOUS_ACTIVITY)
  reason       String         @db.Text
  evidence     String?        @db.Text
  createdAt    DateTime       @default(now())

  targetUser User @relation("TargetReports", fields: [targetUserId], references: [id], onDelete: Cascade)
  reporter   User @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([targetUserId, reporterId])
  @@index([targetUserId])
  @@map("safety_reports")
}

model RestrictionRecord {
  id        Int      @id @default(autoincrement())
  userId    Int
  reason    String   @db.Text
  startsAt  DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation("UserRestrictions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("restriction_records")
}
