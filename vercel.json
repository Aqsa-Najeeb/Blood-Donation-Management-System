{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/find-donors.html",
      "destination": "/src/find-donors.html"
    },
    {
      "source": "/((?!api/|src/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/src/index.html"
    }
  ]
}